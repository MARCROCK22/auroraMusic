if(NOT DEFINED FLUTTER_SOLOUD_ROOT)
  message(FATAL_ERROR "FLUTTER_SOLOUD_ROOT is required")
endif()

file(READ "${FLUTTER_SOLOUD_ROOT}/pubspec.yaml" package_manifest)
if(NOT package_manifest MATCHES "version:[ \t]*3\\.5\\.4([\r\n]|$)")
  message(FATAL_ERROR "Expected flutter_soloud 3.5.4 at ${FLUTTER_SOLOUD_ROOT}")
endif()

set(player "${FLUTTER_SOLOUD_ROOT}/src/player.cpp")
file(READ "${player}" player_source)
set(original "SoLoud::Soloud::CLIP_ROUNDOFF,")
set(patched "0,")
string(REGEX MATCHALL "SoLoud::Soloud::CLIP_ROUNDOFF," clip_flags "${player_source}")
list(LENGTH clip_flags clip_flag_count)
if(clip_flag_count EQUAL 1)
  string(REPLACE "${original}" "${patched}" player_source "${player_source}")
  file(WRITE "${player}" "${player_source}")
elseif(NOT player_source MATCHES "soloud\\.init\\([\r\n \t]*0,")
  message(FATAL_ERROR "Unexpected flutter_soloud 3.5.4 Player::init source; refusing an unsafe patch")
endif()
